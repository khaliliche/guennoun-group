# URL publique du site (sans slash final). Nécessaire pour les balises canoniques / hreflang.
NEXT_PUBLIC_SITE_URL=

# Mettre "true" UNIQUEMENT au lancement officiel. Par défaut, le site demande aux moteurs de recherche de ne pas l'indexer.
NEXT_PUBLIC_ALLOW_INDEXING=false

# Service de réception des formulaires (ex. Formspree, Getform, ou votre propre API).
# Tant que ce champ est vide, le formulaire ouvre le client e-mail du visiteur (mailto) et ne prétend jamais avoir envoyé le message.
NEXT_PUBLIC_FORM_ENDPOINT=
